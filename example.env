APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=${DOCKER_MYSQL_DATABASE:-app_db}
DB_USERNAME=${DOCKER_MYSQL_USER:-app_user}
DB_PASSWORD=${DOCKER_MYSQL_PASSWORD:-userpassword}

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS / DynamoDB Configuration
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID # For local DynamoDB, can be a dummy value like 'dummykey'
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY # For local DynamoDB, can be a dummy value like 'dummysecret'
AWS_DEFAULT_REGION=us-local-1 # For local DynamoDB, use a local region like 'us-local-1' or your preferred one. For AWS, use your actual region.
AWS_BUCKET= # Your S3 bucket if using S3
AWS_USE_PATH_STYLE_ENDPOINT=false # Set to true for MinIO or other S3 compatibles if needed

# For local DynamoDB development, point to the Docker service endpoint.
# For AWS DynamoDB (production), this should typically be empty or not set, 
# allowing the AWS SDK to use the default regional endpoint based on AWS_DEFAULT_REGION.
DYNAMODB_ENDPOINT=http://dynamodb:8000

VITE_APP_NAME="${APP_NAME}"

# Docker Environment Variables
# These are used by docker-compose.yml to configure the services.
# You should create a .env file by copying this example.env and fill these out.

# Application Service (FrankenPHP)
DOCKER_APP_DOCKERFILE=Dockerfile.dev # Options: Dockerfile.dev, Dockerfile.prod
DOCKER_APP_HTTP_PORT=80
DOCKER_APP_HTTPS_PORT=443

# MySQL Service
DOCKER_MYSQL_HOST_PORT=3306
DOCKER_MYSQL_ROOT_PASSWORD=rootpassword # CHANGE THIS IN PRODUCTION!
DOCKER_MYSQL_DATABASE=app_db
DOCKER_MYSQL_USER=app_user
DOCKER_MYSQL_PASSWORD=userpassword # CHANGE THIS IN PRODUCTION!

# Redis Service
DOCKER_REDIS_HOST_PORT=6379
# DOCKER_REDIS_PASSWORD= # If you set a password in your Redis config, set it here too

# DynamoDB Service
DOCKER_DYNAMODB_HOST_PORT=8000

# phpMyAdmin Service
DOCKER_PHPMYADMIN_HOST_PORT=8080

# Redis Commander Service
DOCKER_REDIS_COMMANDER_HOST_PORT=8081

# Horizon Service
DOCKER_HORIZON_DOCKERFILE=Dockerfile.dev # Options: Dockerfile.dev, Dockerfile.prod
